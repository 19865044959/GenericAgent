{
  "description": "GA Memory Benchmark v2 — 跨会话多轮对话",
  "version": "2.0",
  "categories": {
    "cross_session_preference": "Session1 自然提及偏好 → Session2 自动注入偏好",
    "cross_session_identity": "Session1 自然提及身份+技术栈 → Session2 自动注入",
    "abstention": "Session1 无 user profile → Session2 问未提及信息 → 应弃权"
  },
  "_design_note": "每个 case 有两个 session。session_1 是多轮对话，用户自然提及个人信息（不显式要求记忆），进程退出时触发 auto-extraction。session_2 是新进程，auto-retrieval 注入记忆。expected_extraction 既是离线测试的输入（直接喂给 auto_update_l2），也是 e2e 验证的基准（检查 L2 是否包含这些事实）。",
  "test_cases": [
    {
      "id": "CASE-01",
      "category": "cross_session_preference",
      "description": "颜色偏好 — 买衣服时自然提到喜欢的颜色和风格",
      "session_1": {
        "dialogue": [
          {
            "role": "user",
            "content": "最近想买衣服，有什么推荐吗"
          },
          {
            "role": "user",
            "content": "我比较喜欢黑色系，简约风格的"
          },
          {
            "role": "user",
            "content": "好的谢谢，我再想想"
          }
        ],
        "expected_extraction": [
          {
            "section": "用户偏好",
            "key": "颜色偏好",
            "value": "黑色"
          },
          {
            "section": "用户偏好",
            "key": "风格偏好",
            "value": "简约"
          }
        ],
        "scenarios": {
          "before_extraction": {
            "result": {
              "passed": true,
              "score": 0.0
            }
          },
          "after_extraction": {
            "result": {
              "passed": true,
              "score": 1.0,
              "scenario_name": "隐晦用户画像自动萃取",
              "details": {
                "mode": "offline_pre_seed",
                "facts_written": 2,
                "facts_expected": 2,
                "auto_update_returned": 2
              }
            }
          }
        }
      },
      "session_2": {
        "query": "帮我推荐几件衣服",
        "expected_keywords": [
          "黑色",
          "简约"
        ],
        "forbidden_keywords": [
          "你的性别",
          "需要先了解",
          "先告诉我"
        ],
        "min_matched": 2,
        "scenarios": {
          "before_recall": {
            "result": {
              "passed": true,
              "score": 0.0
            }
          },
          "after_recall_keyword": {
            "result": {
              "passed": true,
              "score": 0.0,
              "scenario_name": "关键词召回（预期失败：T恤无同义词映射）",
              "details": {
                "mode": "keyword_fallback",
                "query": "帮我推荐几件衣服",
                "result": "[Auto Retrieved Memory]\n- [用户偏好] 颜色偏好: 黑色\n- [用户偏好] 风格偏好: 简约",
                "facts_recalled": 2,
                "expect_fail": false
              }
            }
          },
          "after_recall_embedding": {
            "result": {
              "passed": true,
              "score": 1.0,
              "scenario_name": "Embedding语义召回（预期成功）",
              "details": {
                "mode": "embedding_semantic",
                "query": "帮我推荐几件衣服",
                "result": "[Auto Retrieved Memory]\n- [用户偏好] 风格偏好: 简约\n- [用户偏好] 颜色偏好: 黑色",
                "facts_recalled": 2,
                "min_required": 2,
                "matched_keywords_in_result": [
                  "黑色",
                  "简约"
                ],
                "embedding_scores": [
                  {
                    "key": "风格偏好",
                    "value": "简约",
                    "score": 0.4597
                  },
                  {
                    "key": "颜色偏好",
                    "value": "黑色",
                    "score": 0.4077
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "CASE-02",
      "category": "cross_session_identity",
      "description": "身份+技术栈 — 写代码时自然提到工作和技能",
      "session_1": {
        "dialogue": [
          {
            "role": "user",
            "content": "帮我写段 Python 代码，解析一下这个 JSON 数据"
          },
          {
            "role": "user",
            "content": "我在腾讯做后端开发，base深圳，主要用 Python + Docker"
          },
          {
            "role": "user",
            "content": "好，先这样"
          }
        ],
        "expected_extraction": [
          {
            "section": "用户画像",
            "key": "组织/公司",
            "value": "腾讯"
          },
          {
            "section": "用户画像",
            "key": "所在地",
            "value": "深圳"
          },
          {
            "section": "用户画像",
            "key": "职位",
            "value": "后端开发"
          },
          {
            "section": "环境配置",
            "key": "技术",
            "value": "Python"
          },
          {
            "section": "环境配置",
            "key": "技术",
            "value": "Docker"
          }
        ]
      },
      "session_2": {
        "query": "以我的技术背景，学什么新技能比较有前景",
        "expected_keywords": [
          "Python",
          "后端",
          "Docker"
        ],
        "forbidden_keywords": [
          "方便告诉我",
          "你目前的技术栈",
          "系统底层"
        ],
        "min_matched": 2
      }
    },
    {
      "id": "CASE-03",
      "category": "abstention",
      "description": "弃权 — 没聊过个人信息，不该编造",
